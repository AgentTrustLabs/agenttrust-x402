{
  "name": "agenttrust",
  "version": "0.1.0",
  "private": true,
  "description": "AgentTrust x402 \u2014 Concordium Agent Registry integration for multi-agent trust and commerce",
  "type": "module",
  "workspaces": [
    "services/facilitator"
  ],
  "files": [
    "dist/",
    "scripts/",
    "src/",
    "README.md"
  ],
  "bin": {
    "agenttrust": "./dist/cli/index.js",
    "agenttrust-verify": "./dist/cli/verify.js",
    "agenttrust-commerce": "./dist/cli/commerce.js",
    "agenttrust-discovery": "./dist/cli/discovery.js",
    "agenttrust-mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc && npm run build:wallet-context",
    "pretest": "npm run build:peercred && tsc",
    "test": "node test/run.mjs",
    "verify": "tsc && node dist/cli/verify.js",
    "commerce": "tsc && node dist/cli/commerce.js",
    "mcp": "tsc && node dist/mcp/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:launcher": "tsc -p tsconfig.launcher.json",
    "lint": "tsc --noEmit",
    "cli": "node --import tsx --experimental-vm-modules dist/cli/index.js",
    "build:peercred": "sh scripts/build-peercred.sh",
    "prebuild": "npm run build:peercred",
    "postinstall": "npm run build:peercred",
    "build:wallet-context": "esbuild src/wallet/wallet-context-entry.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/wallet-context-bundle.js",
    "build:production-config": "node scripts/build-production-config.mjs"
  },
  "dependencies": {
    "@concordium/web-sdk": "^12.0.2",
    "@x402/concordium": "^2.29.0",
    "@x402/core": "^2.29.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
